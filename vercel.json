{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tratamentos",
      "destination": "https://viriatum-quizz-produto.vercel.app/tratamentos"
    },
    {
      "source": "/tratamentos/:path*",
      "destination": "https://viriatum-quizz-produto.vercel.app/tratamentos/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
